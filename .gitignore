# .gitignore - Place this in your project root folder

# Dependencies (too large, should not be in GitHub)
node_modules/

# Build output
dist/
build/
.vercel/

# Environment files with REAL keys (NEVER commit these)
.env
.env.local
.env.*.local
.env.production
.env.development

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Supabase
supabase/.temp/